// Moksha Wellness Admin Panel — Prisma schema
// Money is stored as integer paise (BigInt). PII (Aadhaar/PAN, tokens) is
// encrypted at the application layer before it reaches these string columns.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm]
}

// ───────────────────────── Enums ─────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  FRONT_DESK
  ACCOUNTANT
  TRAINER
}

enum CourseCategory {
  REGULAR
  TEACHER_TRAINING
}

enum Discipline {
  YOGA
  PILATES
  DANCE
}

enum DurationType {
  MONTH_1
  MONTH_3
  MONTH_12
  HRS_200
  HRS_300
  HRS_600
  CUSTOM
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ConsentStatus {
  DRAFT
  FINALIZED
}

enum InvoiceType {
  ENROLLMENT
  RENEWAL
  PRODUCT
  MIXED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum ProductType {
  MAT
  TSHIRT
  NUTRITION_DRINK
  OTHER
}

enum InventoryReason {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum LeadSource {
  WHATSAPP
  WEBSITE
  GOOGLE_FORM
  LINKEDIN
  WALK_IN
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  LOST
}

enum NotificationType {
  RENEWAL_DUE
  PAYMENT_RECEIVED
  NEW_LEAD
  LOW_STOCK
  CONSENT_PENDING
  SYSTEM
}

enum GeneralStatus {
  ACTIVE
  INACTIVE
}

// ───────────────────────── Auth & system ─────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(FRONT_DESK)
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  studentsCreated   Student[]       @relation("StudentCreatedBy")
  enrollmentsMade   Enrollment[]    @relation("EnrollmentCreatedBy")
  invoicesMade      Invoice[]       @relation("InvoiceCreatedBy")
  paymentsReceived  Payment[]       @relation("PaymentReceivedBy")
  notifications     Notification[]
  auditLogs         AuditLog[]
  employee          Employee?

  @@index([role])
  @@map("users")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String?          @map("user_id") @db.Uuid
  roleTarget UserRole?        @map("role_target")
  type       NotificationType
  title      String
  body       String?
  entity     String?
  entityId   String?          @map("entity_id") @db.Uuid
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id") @db.Uuid
  meta      Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

// ───────────────────────── Students & consent ─────────────────────────

model Student {
  id                       String        @id @default(uuid()) @db.Uuid
  fullName                 String        @map("full_name")
  mobile                   String        @unique
  email                    String?
  dob                      DateTime?     @db.Date
  gender                   String?
  address                  String?
  emergencyContactName     String?       @map("emergency_contact_name")
  emergencyContactPhone    String?       @map("emergency_contact_phone")
  emergencyContactRelation String?       @map("emergency_contact_relation")
  isMinor                  Boolean       @default(false) @map("is_minor")
  status                   GeneralStatus @default(ACTIVE)
  leadId                   String?       @map("lead_id") @db.Uuid
  createdById              String?       @map("created_by") @db.Uuid
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  createdBy    User?         @relation("StudentCreatedBy", fields: [createdById], references: [id])
  convertedFrom Lead?        @relation("LeadConvertedStudent")
  enrollments  Enrollment[]
  consentForms ConsentForm[]
  invoices     Invoice[]
  receipts     Receipt[]

  @@index([mobile])
  @@map("students")
}

/// Editable default content for the consent form. Each finalized form snapshots
/// the sections it used, so editing a template never changes past forms.
model ConsentTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  version   Int
  title     String
  sections  Json // { healthOptions: [...], clauses: { safety, policies, conduct, final } }
  isActive  Boolean  @default(false) @map("is_active")
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("consent_templates")
}

model ConsentForm {
  id                 String        @id @default(uuid()) @db.Uuid
  studentId          String        @map("student_id") @db.Uuid
  enrollmentId       String?       @map("enrollment_id") @db.Uuid
  templateVersion    Int?          @map("template_version")
  batchTimingLabel   String?       @map("batch_timing_label")
  formDate           DateTime      @map("form_date") @db.Date
  // Fee snapshot for the enrolled course (shown on the printed consent)
  courseName         String?       @map("course_name")
  planTitle          String?       @map("plan_title")
  feePaise           BigInt?       @map("fee_paise")
  amountPaidPaise    BigInt?       @map("amount_paid_paise")
  balancePaise       BigInt?       @map("balance_paise")
  // Section 1 — health declaration
  healthFlags        Json?         @map("health_flags")
  healthOther        String?       @map("health_other")
  // Sections 2–5 — acknowledgements
  consentSafetyAck   Boolean       @default(false) @map("consent_safety_ack")
  studioPoliciesAck  Boolean       @default(false) @map("studio_policies_ack")
  codeOfConductAck   Boolean       @default(false) @map("code_of_conduct_ack")
  finalAck           Boolean       @default(false) @map("final_ack")
  clauseSnapshot     Json?         @map("clause_snapshot")
  // Signatures
  studentSignatureUrl  String?     @map("student_signature_url")
  studentSignedDate    DateTime?   @map("student_signed_date") @db.Date
  guardianSignatureUrl String?     @map("guardian_signature_url")
  guardianSignedDate   DateTime?   @map("guardian_signed_date") @db.Date
  trainerVerifiedBy    String?     @map("trainer_verified_by") @db.Uuid
  trainerVerifiedDate  DateTime?   @map("trainer_verified_date") @db.Date
  pdfUrl             String?       @map("pdf_url")
  status             ConsentStatus @default(DRAFT)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment Enrollment?      @relation(fields: [enrollmentId], references: [id])
  uploads    ConsentUpload[]

  @@index([studentId])
  @@map("consent_forms")
}

/// Photo/scan of the physically-signed consent form, re-uploaded after signing.
model ConsentUpload {
  id            String   @id @default(uuid()) @db.Uuid
  consentFormId String   @map("consent_form_id") @db.Uuid
  fileUrl       String   @map("file_url")
  uploadedBy    String?  @map("uploaded_by") @db.Uuid
  note          String?
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  consentForm ConsentForm @relation(fields: [consentFormId], references: [id], onDelete: Cascade)

  @@map("consent_uploads")
}

// ───────────────────────── Courses, timings, enrollments ─────────────────────────

model Course {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  category    CourseCategory
  discipline  Discipline?
  description String?
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  plans    CoursePlan[]
  timings  ClassTiming[]
  leads    Lead[]

  @@map("courses")
}

model CoursePlan {
  id             String       @id @default(uuid()) @db.Uuid
  courseId       String       @map("course_id") @db.Uuid
  title          String
  durationType   DurationType @map("duration_type")
  durationValue  Int?         @map("duration_value")
  pricePaise     BigInt       @map("price_paise")
  sessionsPerWeek Int?        @map("sessions_per_week")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([courseId])
  @@map("course_plans")
}

/// Maintained class-schedule slots (which timing a student enrolls for).
model ClassTiming {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String?  @map("course_id") @db.Uuid
  label     String
  days      Json? // ["MON","WED","FRI"]
  startTime DateTime? @map("start_time") @db.Time
  endTime   DateTime? @map("end_time") @db.Time
  trainerId String?  @map("trainer_id") @db.Uuid
  capacity  Int?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  trainer     Employee?    @relation(fields: [trainerId], references: [id])
  enrollments Enrollment[]

  @@map("class_timings")
}

model Enrollment {
  id                 String           @id @default(uuid()) @db.Uuid
  studentId          String           @map("student_id") @db.Uuid
  coursePlanId       String           @map("course_plan_id") @db.Uuid
  classTimingId      String?          @map("class_timing_id") @db.Uuid
  startDate          DateTime         @map("start_date") @db.Date
  endDate            DateTime         @map("end_date") @db.Date
  pricePaise         BigInt           @map("price_paise")
  discountPaise      BigInt           @default(0) @map("discount_paise")
  status             EnrollmentStatus @default(ACTIVE)
  parentEnrollmentId String?          @map("parent_enrollment_id") @db.Uuid
  createdById        String?          @map("created_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coursePlan      CoursePlan    @relation(fields: [coursePlanId], references: [id])
  classTiming     ClassTiming?  @relation(fields: [classTimingId], references: [id])
  parentEnrollment Enrollment?  @relation("Renewal", fields: [parentEnrollmentId], references: [id])
  renewals        Enrollment[]  @relation("Renewal")
  createdBy       User?         @relation("EnrollmentCreatedBy", fields: [createdById], references: [id])
  consentForms    ConsentForm[]

  @@index([studentId])
  @@index([status, endDate]) // renewal-due scans
  @@map("enrollments")
}

// ───────────────────────── Billing ─────────────────────────

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNo       String        @unique @map("invoice_no")
  studentId       String?       @map("student_id") @db.Uuid
  type            InvoiceType
  subtotalPaise   BigInt        @default(0) @map("subtotal_paise")
  discountPaise   BigInt        @default(0) @map("discount_paise")
  taxPaise        BigInt        @default(0) @map("tax_paise")
  totalPaise      BigInt        @default(0) @map("total_paise")
  amountPaidPaise BigInt        @default(0) @map("amount_paid_paise")
  status          InvoiceStatus @default(UNPAID)
  dueDate         DateTime?     @map("due_date") @db.Date
  notes           String?
  createdById     String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  student   Student?               @relation(fields: [studentId], references: [id])
  createdBy User?                  @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items     InvoiceItem[]
  payments  Payment[]
  invTx     InventoryTransaction[]

  @@index([studentId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  itemType       String   @map("item_type") // COURSE_PLAN | PRODUCT_VARIANT | CUSTOM
  refId          String?  @map("ref_id") @db.Uuid
  description    String
  qty            Int      @default(1)
  unitPricePaise BigInt   @map("unit_price_paise")
  lineTotalPaise BigInt   @map("line_total_paise")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id          String      @id @default(uuid()) @db.Uuid
  invoiceId   String      @map("invoice_id") @db.Uuid
  amountPaise BigInt      @map("amount_paise")
  mode        PaymentMode
  referenceNo String?     @map("reference_no")
  paidAt      DateTime    @default(now()) @map("paid_at")
  receivedById String?    @map("received_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedBy User?    @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  receipt    Receipt?

  @@index([invoiceId])
  @@map("payments")
}

model Receipt {
  id          String   @id @default(uuid()) @db.Uuid
  receiptNo   String   @unique @map("receipt_no")
  paymentId   String   @unique @map("payment_id") @db.Uuid
  studentId   String?  @map("student_id") @db.Uuid
  pdfUrl      String?  @map("pdf_url")
  generatedAt DateTime @default(now()) @map("generated_at")

  payment Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id])

  @@map("receipts")
}

// ───────────────────────── Inventory ─────────────────────────

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  type        ProductType
  description String?
  imageUrl    String?     @map("image_url")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  variants ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantLabel String   @map("variant_label")
  attributes   Json? // {size:"M"} / {thickness:"6mm"} / {flavour:"Chocolate"}
  sku          String   @unique
  pricePaise   BigInt   @map("price_paise")
  stockQty     Int      @default(0) @map("stock_qty")
  reorderLevel Int      @default(0) @map("reorder_level")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@index([productId])
  @@map("product_variants")
}

model InventoryTransaction {
  id          String          @id @default(uuid()) @db.Uuid
  variantId   String          @map("variant_id") @db.Uuid
  changeQty   Int             @map("change_qty")
  reason      InventoryReason
  refInvoiceId String?        @map("ref_invoice_id") @db.Uuid
  note        String?
  createdById String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")

  variant    ProductVariant @relation(fields: [variantId], references: [id])
  refInvoice Invoice?       @relation(fields: [refInvoiceId], references: [id])

  @@index([variantId, createdAt])
  @@map("inventory_transactions")
}

// ───────────────────────── Employees (HR) ─────────────────────────

model Employee {
  id            String        @id @default(uuid()) @db.Uuid
  fullName      String        @map("full_name")
  email         String?
  phone         String        @unique
  roleTitle     String?       @map("role_title")
  aadhaarNo     String?       @map("aadhaar_no") // encrypted ciphertext
  panNo         String?       @map("pan_no")     // encrypted ciphertext
  dateOfJoining DateTime?     @map("date_of_joining") @db.Date
  address       String?
  salaryPaise   BigInt?       @map("salary_paise")
  status        GeneralStatus @default(ACTIVE)
  userId        String?       @unique @map("user_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user      User?              @relation(fields: [userId], references: [id])
  documents EmployeeDocument[]
  timings   ClassTiming[]

  @@map("employees")
}

model EmployeeDocument {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  docType    String   @map("doc_type") // AADHAAR | PAN | PHOTO | CERTIFICATE | OTHER
  fileUrl    String   @map("file_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

// ───────────────────────── Leads & integrations ─────────────────────────

model Lead {
  id                 String     @id @default(uuid()) @db.Uuid
  name               String?
  phone              String?
  email              String?
  message            String?
  source             LeadSource
  sourceDetail       Json?      @map("source_detail")
  interestedIn       String?    @map("interested_in") @db.Uuid
  status             LeadStatus @default(NEW)
  assignedToId       String?    @map("assigned_to") @db.Uuid
  convertedStudentId String?    @unique @map("converted_student_id") @db.Uuid
  receivedAt         DateTime   @default(now()) @map("received_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  interestedCourse Course?        @relation(fields: [interestedIn], references: [id])
  convertedStudent Student?       @relation("LeadConvertedStudent", fields: [convertedStudentId], references: [id])
  activities       LeadActivity[]

  @@index([source])
  @@index([status])
  @@index([receivedAt])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String // NOTE | CALL | WHATSAPP | EMAIL | STATUS_CHANGE
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model WebhookEvent {
  id             String   @id @default(uuid()) @db.Uuid
  channel        String
  rawPayload     Json?    @map("raw_payload")
  signatureValid Boolean? @map("signature_valid")
  processed      Boolean  @default(false)
  error          String?
  receivedAt     DateTime @default(now()) @map("received_at")

  @@index([processed, receivedAt])
  @@map("webhook_events")
}

model IntegrationSetting {
  id        String   @id @default(uuid()) @db.Uuid
  channel   String   @unique
  config    Json? // encrypted tokens/IDs
  isEnabled Boolean  @default(false) @map("is_enabled")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("integration_settings")
}
