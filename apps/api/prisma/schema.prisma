// Moksha Wellness Admin Panel — Prisma schema
// Money is stored as integer paise (BigInt). PII (Aadhaar/PAN, tokens) is
// encrypted at the application layer before it reaches these string columns.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm]
}

// ───────────────────────── Enums ─────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  FRONT_DESK
  ACCOUNTANT
  TRAINER
}

enum CourseCategory {
  REGULAR
  TEACHER_TRAINING
}

/// How a course is delivered. HYBRID = offered both offline and online.
enum DeliveryMode {
  OFFLINE
  ONLINE
  HYBRID
}

enum Discipline {
  YOGA
  PILATES
  DANCE
}

enum DurationType {
  MONTH_1
  MONTH_3
  MONTH_12
  HRS_200
  HRS_300
  HRS_600
  CUSTOM
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ConsentStatus {
  DRAFT
  FINALIZED
}

enum InvoiceType {
  ENROLLMENT
  RENEWAL
  PRODUCT
  MIXED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum ProductType {
  MAT
  TSHIRT
  NUTRITION_DRINK
  OTHER
}

enum InventoryReason {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum LeadSource {
  WHATSAPP
  WEBSITE
  GOOGLE_FORM
  LINKEDIN
  WALK_IN
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  LOST
}

enum NotificationType {
  RENEWAL_DUE
  PAYMENT_RECEIVED
  NEW_LEAD
  LOW_STOCK
  CONSENT_PENDING
  SYSTEM
}

enum GeneralStatus {
  ACTIVE
  INACTIVE
}

// ───────────────────────── Auth & system ─────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(FRONT_DESK)
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  studentsCreated  Student[]      @relation("StudentCreatedBy")
  enrollmentsMade  Enrollment[]   @relation("EnrollmentCreatedBy")
  invoicesMade     Invoice[]      @relation("InvoiceCreatedBy")
  paymentsReceived Payment[]      @relation("PaymentReceivedBy")
  notifications    Notification[]
  auditLogs        AuditLog[]
  employee         Employee?
  sessions         StaffSession[]

  @@index([role])
  @@map("users")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String?          @map("user_id") @db.Uuid
  roleTarget UserRole?        @map("role_target")
  type       NotificationType
  title      String
  body       String?
  entity     String?
  entityId   String?          @map("entity_id") @db.Uuid
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id") @db.Uuid
  meta      Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

// ───────────────────────── Students & consent ─────────────────────────

model Student {
  id                        String        @id @default(uuid()) @db.Uuid
  /// Human-readable Student ID (e.g. STU-0001, or the legacy ID from an import).
  studentCode               String?       @unique @map("student_code")
  fullName                  String        @map("full_name")
  mobile                    String        @unique
  email                     String?
  dob                       DateTime?     @db.Date
  gender                    String?
  address                   String?
  emergencyContactName      String?       @map("emergency_contact_name")
  emergencyContactPhone     String?       @map("emergency_contact_phone")
  emergencyContactRelation  String?       @map("emergency_contact_relation")
  isMinor                   Boolean       @default(false) @map("is_minor")
  /// Manual flag only (INACTIVE = deactivated by an admin). The displayed
  /// status is computed from this + the student's enrolments.
  status                    GeneralStatus @default(ACTIVE)
  deactivationReason        String?       @map("deactivation_reason")
  deactivationEffectiveDate DateTime?     @map("deactivation_effective_date") @db.Date
  deactivatedAt             DateTime?     @map("deactivated_at")
  deactivatedById           String?       @map("deactivated_by") @db.Uuid
  leadId                    String?       @map("lead_id") @db.Uuid
  createdById               String?       @map("created_by") @db.Uuid
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")

  createdBy     User?            @relation("StudentCreatedBy", fields: [createdById], references: [id])
  convertedFrom Lead?            @relation("LeadConvertedStudent")
  enrollments   Enrollment[]
  consentForms  ConsentForm[]
  invoices      Invoice[]
  receipts      Receipt[]
  account       CustomerAccount?

  @@index([mobile])
  @@index([email])
  @@map("students")
}

/// Editable default content for the consent form. Each finalized form snapshots
/// the sections it used, so editing a template never changes past forms.
model ConsentTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  version   Int
  title     String
  sections  Json // { healthOptions: [...], clauses: { safety, policies, conduct, final } }
  isActive  Boolean  @default(false) @map("is_active")
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("consent_templates")
}

model ConsentForm {
  id                   String        @id @default(uuid()) @db.Uuid
  studentId            String        @map("student_id") @db.Uuid
  enrollmentId         String?       @map("enrollment_id") @db.Uuid
  templateVersion      Int?          @map("template_version")
  batchTimingLabel     String?       @map("batch_timing_label")
  formDate             DateTime      @map("form_date") @db.Date
  // Fee snapshot for the enrolled course (shown on the printed consent)
  courseName           String?       @map("course_name")
  planTitle            String?       @map("plan_title")
  feePaise             BigInt?       @map("fee_paise")
  amountPaidPaise      BigInt?       @map("amount_paid_paise")
  balancePaise         BigInt?       @map("balance_paise")
  // Section 1 — health declaration
  healthFlags          Json?         @map("health_flags")
  healthOther          String?       @map("health_other")
  // Sections 2–5 — acknowledgements
  consentSafetyAck     Boolean       @default(false) @map("consent_safety_ack")
  studioPoliciesAck    Boolean       @default(false) @map("studio_policies_ack")
  codeOfConductAck     Boolean       @default(false) @map("code_of_conduct_ack")
  finalAck             Boolean       @default(false) @map("final_ack")
  clauseSnapshot       Json?         @map("clause_snapshot")
  // Signatures
  studentSignatureUrl  String?       @map("student_signature_url")
  studentSignedDate    DateTime?     @map("student_signed_date") @db.Date
  guardianSignatureUrl String?       @map("guardian_signature_url")
  guardianSignedDate   DateTime?     @map("guardian_signed_date") @db.Date
  trainerVerifiedBy    String?       @map("trainer_verified_by") @db.Uuid
  trainerVerifiedDate  DateTime?     @map("trainer_verified_date") @db.Date
  pdfUrl               String?       @map("pdf_url")
  status               ConsentStatus @default(DRAFT)
  finalizedAt          DateTime?     @map("finalized_at")
  finalizedById        String?       @map("finalized_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment Enrollment?     @relation(fields: [enrollmentId], references: [id])
  uploads    ConsentUpload[]

  @@index([studentId])
  @@map("consent_forms")
}

/// Photo/scan of the physically-signed consent form, re-uploaded after signing.
model ConsentUpload {
  id            String   @id @default(uuid()) @db.Uuid
  consentFormId String   @map("consent_form_id") @db.Uuid
  fileUrl       String   @map("file_url")
  fileKey       String?  @map("file_key")
  fileName      String?  @map("file_name")
  mimeType      String?  @map("mime_type")
  sizeBytes     Int?     @map("size_bytes")
  uploadedBy    String?  @map("uploaded_by") @db.Uuid
  note          String?
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  consentForm ConsentForm @relation(fields: [consentFormId], references: [id], onDelete: Cascade)

  @@index([consentFormId])
  @@map("consent_uploads")
}

// ───────────────────────── Courses, timings, enrollments ─────────────────────────

model Course {
  id            String         @id @default(uuid()) @db.Uuid
  /// Stable short code (used by the catalogue sync and the legacy import).
  code          String?        @unique
  name          String
  category      CourseCategory
  discipline    Discipline?
  /// Null = delivery mode not yet confirmed by the business.
  deliveryMode  DeliveryMode?  @map("delivery_mode")
  description   String?
  isActive      Boolean        @default(true) @map("is_active")
  // ── Public website fields (the website's programme list comes from here) ──
  /// URL slug on the website, e.g. "regular-studio-yoga".
  slug          String?        @unique
  isPublished   Boolean        @default(false) @map("is_published")
  publicSummary String?        @map("public_summary")
  publicForWhom String?        @map("public_for_whom")
  displayOrder  Int            @default(0) @map("display_order")
  imageUrl      String?        @map("image_url")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  plans   CoursePlan[]
  timings ClassTiming[]
  leads   Lead[]

  @@map("courses")
}

model CoursePlan {
  id                  String       @id @default(uuid()) @db.Uuid
  courseId            String       @map("course_id") @db.Uuid
  title               String
  durationType        DurationType @map("duration_type")
  durationValue       Int?         @map("duration_value")
  pricePaise          BigInt       @map("price_paise")
  sessionsPerWeek     Int?         @map("sessions_per_week")
  isActive            Boolean      @default(true) @map("is_active")
  /// Students may buy this plan online from the website (its fee is then shown publicly).
  isOnlinePurchasable Boolean      @default(false) @map("is_online_purchasable")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([courseId])
  @@map("course_plans")
}

/// Maintained class-schedule slots (which timing a student enrolls for).
model ClassTiming {
  id        String    @id @default(uuid()) @db.Uuid
  courseId  String?   @map("course_id") @db.Uuid
  label     String
  days      Json? // ["MON","WED","FRI"]
  startTime DateTime? @map("start_time") @db.Time
  endTime   DateTime? @map("end_time") @db.Time
  trainerId String?   @map("trainer_id") @db.Uuid
  capacity  Int?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  trainer     Employee?    @relation(fields: [trainerId], references: [id])
  enrollments Enrollment[]

  @@map("class_timings")
}

model Enrollment {
  id                 String           @id @default(uuid()) @db.Uuid
  studentId          String           @map("student_id") @db.Uuid
  coursePlanId       String           @map("course_plan_id") @db.Uuid
  classTimingId      String?          @map("class_timing_id") @db.Uuid
  startDate          DateTime         @map("start_date") @db.Date
  endDate            DateTime         @map("end_date") @db.Date
  pricePaise         BigInt           @map("price_paise")
  discountPaise      BigInt           @default(0) @map("discount_paise")
  status             EnrollmentStatus @default(ACTIVE)
  /// The enrolment this one renews. Unique: a period can be renewed only once,
  /// which makes a retried/double-clicked renewal impossible at the DB level.
  parentEnrollmentId String?          @unique @map("parent_enrollment_id") @db.Uuid
  notes              String?
  createdById        String?          @map("created_by") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coursePlan       CoursePlan    @relation(fields: [coursePlanId], references: [id])
  classTiming      ClassTiming?  @relation(fields: [classTimingId], references: [id])
  parentEnrollment Enrollment?   @relation("Renewal", fields: [parentEnrollmentId], references: [id])
  renewal          Enrollment?   @relation("Renewal")
  createdBy        User?         @relation("EnrollmentCreatedBy", fields: [createdById], references: [id])
  consentForms     ConsentForm[]
  invoices         Invoice[]

  @@index([studentId])
  @@index([status, endDate]) // renewal-due scans
  @@map("enrollments")
}

// ───────────────────────── Billing ─────────────────────────

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNo       String        @unique @map("invoice_no")
  studentId       String?       @map("student_id") @db.Uuid
  /// The enrolment/renewal this invoice bills (null for product/mixed invoices).
  enrollmentId    String?       @map("enrollment_id") @db.Uuid
  type            InvoiceType
  subtotalPaise   BigInt        @default(0) @map("subtotal_paise")
  discountPaise   BigInt        @default(0) @map("discount_paise")
  taxPaise        BigInt        @default(0) @map("tax_paise")
  totalPaise      BigInt        @default(0) @map("total_paise")
  amountPaidPaise BigInt        @default(0) @map("amount_paid_paise")
  status          InvoiceStatus @default(UNPAID)
  dueDate         DateTime?     @map("due_date") @db.Date
  notes           String?
  createdById     String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  student    Student?               @relation(fields: [studentId], references: [id])
  enrollment Enrollment?            @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  createdBy  User?                  @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items      InvoiceItem[]
  payments   Payment[]
  invTx      InventoryTransaction[]

  @@index([studentId])
  @@index([enrollmentId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  itemType       String  @map("item_type") // COURSE_PLAN | PRODUCT_VARIANT | CUSTOM
  refId          String? @map("ref_id") @db.Uuid
  description    String
  qty            Int     @default(1)
  unitPricePaise BigInt  @map("unit_price_paise")
  lineTotalPaise BigInt  @map("line_total_paise")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id             String      @id @default(uuid()) @db.Uuid
  invoiceId      String      @map("invoice_id") @db.Uuid
  amountPaise    BigInt      @map("amount_paise")
  mode           PaymentMode
  referenceNo    String?     @map("reference_no")
  paidAt         DateTime    @default(now()) @map("paid_at")
  receivedById   String?     @map("received_by") @db.Uuid
  /// Client-generated key: a retried or double-clicked submission can never
  /// create a second payment.
  idempotencyKey String?     @unique @map("idempotency_key")
  notes          String?
  /// Amount refunded through the payment gateway (paise).
  refundedPaise  BigInt      @default(0) @map("refunded_paise")
  createdAt      DateTime    @default(now()) @map("created_at")

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedBy User?    @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  receipt    Receipt?

  @@index([invoiceId])
  @@map("payments")
}

model Receipt {
  id          String   @id @default(uuid()) @db.Uuid
  receiptNo   String   @unique @map("receipt_no")
  paymentId   String   @unique @map("payment_id") @db.Uuid
  studentId   String?  @map("student_id") @db.Uuid
  pdfUrl      String?  @map("pdf_url")
  generatedAt DateTime @default(now()) @map("generated_at")

  payment Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id])

  @@map("receipts")
}

// ───────────────────────── Inventory ─────────────────────────

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  type        ProductType
  description String?
  imageUrl    String?     @map("image_url")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  variants ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantLabel String   @map("variant_label")
  attributes   Json? // {size:"M"} / {thickness:"6mm"} / {flavour:"Chocolate"}
  sku          String   @unique
  pricePaise   BigInt   @map("price_paise")
  stockQty     Int      @default(0) @map("stock_qty")
  reorderLevel Int      @default(0) @map("reorder_level")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@index([productId])
  @@map("product_variants")
}

model InventoryTransaction {
  id           String          @id @default(uuid()) @db.Uuid
  variantId    String          @map("variant_id") @db.Uuid
  changeQty    Int             @map("change_qty")
  reason       InventoryReason
  refInvoiceId String?         @map("ref_invoice_id") @db.Uuid
  note         String?
  createdById  String?         @map("created_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")

  variant    ProductVariant @relation(fields: [variantId], references: [id])
  refInvoice Invoice?       @relation(fields: [refInvoiceId], references: [id])

  @@index([variantId, createdAt])
  @@map("inventory_transactions")
}

// ───────────────────────── Employees (HR) ─────────────────────────

model Employee {
  id            String        @id @default(uuid()) @db.Uuid
  fullName      String        @map("full_name")
  email         String?
  phone         String        @unique
  roleTitle     String?       @map("role_title")
  aadhaarNo     String?       @map("aadhaar_no") // encrypted ciphertext
  panNo         String?       @map("pan_no") // encrypted ciphertext
  dateOfJoining DateTime?     @map("date_of_joining") @db.Date
  address       String?
  salaryPaise   BigInt?       @map("salary_paise")
  status        GeneralStatus @default(ACTIVE)
  userId        String?       @unique @map("user_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user        User?              @relation(fields: [userId], references: [id])
  documents   EmployeeDocument[]
  timings     ClassTiming[]
  teamProfile TeamMember?

  @@map("employees")
}

model EmployeeDocument {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  docType    String   @map("doc_type") // AADHAAR | PAN | PHOTO | CERTIFICATE | OTHER
  fileUrl    String   @map("file_url")
  /// Storage key — files are served through an authenticated route, never by long-lived URL.
  fileKey    String?  @map("file_key")
  mimeType   String?  @map("mime_type")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

// ───────────────────────── Leads & integrations ─────────────────────────

model Lead {
  id                 String     @id @default(uuid()) @db.Uuid
  name               String?
  phone              String?
  email              String?
  message            String?
  source             LeadSource
  sourceDetail       Json?      @map("source_detail")
  interestedIn       String?    @map("interested_in") @db.Uuid
  status             LeadStatus @default(NEW)
  assignedToId       String?    @map("assigned_to") @db.Uuid
  convertedStudentId String?    @unique @map("converted_student_id") @db.Uuid
  receivedAt         DateTime   @default(now()) @map("received_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  interestedCourse Course?        @relation(fields: [interestedIn], references: [id])
  convertedStudent Student?       @relation("LeadConvertedStudent", fields: [convertedStudentId], references: [id])
  activities       LeadActivity[]

  @@index([source])
  @@index([status])
  @@index([receivedAt])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String // NOTE | CALL | WHATSAPP | EMAIL | STATUS_CHANGE
  content   String?
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model WebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  channel         String
  rawPayload      Json?    @map("raw_payload")
  signatureValid  Boolean? @map("signature_valid")
  /// Provider event id (e.g. x-razorpay-event-id) — makes webhook processing idempotent.
  externalEventId String?  @unique @map("external_event_id")
  processed       Boolean  @default(false)
  error           String?
  receivedAt      DateTime @default(now()) @map("received_at")

  @@index([processed, receivedAt])
  @@map("webhook_events")
}

model IntegrationSetting {
  id        String   @id @default(uuid()) @db.Uuid
  channel   String   @unique
  config    Json? // encrypted tokens/IDs
  isEnabled Boolean  @default(false) @map("is_enabled")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("integration_settings")
}

// ───────────────────────── Counters & outbound messages ─────────────────────────

/// Atomic sequences (invoice / receipt / student numbers) — avoids the
/// count()+1 race that produces duplicate-number errors under concurrency.
model Counter {
  key   String @id
  value Int

  @@map("counters")
}

/// One row per outbound message event (WhatsApp reminders/notifications).
/// dedupeKey makes "same event, same reminder window" send at most once.
model MessageLog {
  id                String    @id @default(uuid()) @db.Uuid
  channel           String    @default("WHATSAPP")
  event             String // RENEWAL_REMINDER | PAYMENT_RECEIVED | ADMISSION_CONFIRMATION
  dedupeKey         String    @unique @map("dedupe_key")
  studentId         String?   @map("student_id") @db.Uuid
  enrollmentId      String?   @map("enrollment_id") @db.Uuid
  recipient         String?
  templateName      String?   @map("template_name")
  params            Json?
  status            String // PENDING | SENT | DELIVERED | READ | FAILED | NOT_CONFIGURED | INVALID_RECIPIENT
  attempts          Int       @default(0)
  providerMessageId String?   @map("provider_message_id")
  providerResponse  Json?     @map("provider_response")
  error             String?
  triggeredBy       String?   @map("triggered_by")
  /// QUEUED rows are sent by the job runner once scheduledFor has passed.
  scheduledFor      DateTime? @map("scheduled_for")
  campaignId        String?   @map("campaign_id") @db.Uuid
  ruleId            String?   @map("rule_id") @db.Uuid
  templateId        String?   @map("template_id") @db.Uuid
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([enrollmentId])
  @@index([providerMessageId])
  @@index([status, createdAt])
  @@index([status, scheduledFor])
  @@index([campaignId])
  @@map("message_logs")
}

// ───────────────────────── Website accounts (students / customers) ─────────────────────────
// Separate from staff `users`. Every account has a mobile number. Accounts are
// never attached to a studio Student record automatically (the number is not
// verified): staff link them on the admin panel's "Website Logins" page.

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum AuthMethod {
  MOBILE_PASSWORD
  EMAIL_PASSWORD
  GOOGLE
}

model CustomerAccount {
  id                 String        @id @default(uuid()) @db.Uuid
  fullName           String        @map("full_name")
  /// 10-digit Indian mobile (same normalisation as students.mobile).
  mobile             String        @unique
  /// Stored lower-case; unique so it can be used to sign in (mobile stays mandatory).
  email              String?       @unique
  /// bcrypt hash; null for Google-only accounts until they set a password.
  passwordHash       String?       @map("password_hash")
  signupMethod       AuthMethod    @map("signup_method")
  status             AccountStatus @default(ACTIVE)
  studentId          String?       @unique @map("student_id") @db.Uuid
  linkedAt           DateTime?     @map("linked_at")
  linkedById         String?       @map("linked_by") @db.Uuid
  lastLoginAt        DateTime?     @map("last_login_at")
  loginCount         Int           @default(0) @map("login_count")
  /// Staff-issued temporary password must be changed at next sign-in.
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  student     Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  identities  AuthIdentity[]
  sessions    CustomerSession[]
  loginEvents CustomerLoginEvent[]
  orders      PaymentOrder[]

  @@index([createdAt])
  @@index([lastLoginAt])
  @@map("customer_accounts")
}

/// External sign-in identities linked to an account (currently Google).
model AuthIdentity {
  id        String     @id @default(uuid()) @db.Uuid
  accountId String     @map("account_id") @db.Uuid
  provider  AuthMethod
  /// Provider's stable user id (Google "sub").
  subject   String
  email     String?
  createdAt DateTime   @default(now()) @map("created_at")

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([accountId])
  @@map("auth_identities")
}

/// Opaque, revocable website sessions. Only a SHA-256 of the token is stored.
model CustomerSession {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("customer_sessions")
}

/// Every website sign-in and failed attempt — shown on the Website Logins page.
model CustomerLoginEvent {
  id        String     @id @default(uuid()) @db.Uuid
  accountId String?    @map("account_id") @db.Uuid
  mobile    String?
  method    AuthMethod
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?    @map("user_agent")
  createdAt DateTime   @default(now()) @map("created_at")

  account CustomerAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([createdAt])
  @@map("customer_login_events")
}

/// Staff refresh-token sessions: rotated on every refresh, revocable, re-checked against the user.
model StaffSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  /// Set when this token was exchanged for a new one; presenting it again revokes all the user's sessions.
  rotatedAt DateTime? @map("rotated_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("staff_sessions")
}

// ───────────────────────── Website content (CMS) ─────────────────────────

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
}

/// Files uploaded for the public website (public bucket).
model MediaAsset {
  id           String    @id @default(uuid()) @db.Uuid
  kind         MediaKind
  storageKey   String    @unique @map("storage_key")
  url          String
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  originalName String?   @map("original_name")
  alt          String?
  uploadedById String?   @map("uploaded_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@map("media_assets")
}

/// Structured page sections (home hero, about story, contact details…). JSON validated by @moksha/shared.
model ContentBlock {
  key           String    @id
  draft         Json
  published     Json?
  publishedAt   DateTime? @map("published_at")
  updatedById   String?   @map("updated_by") @db.Uuid
  publishedById String?   @map("published_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("content_blocks")
}

/// Public team profile. Deliberately separate from the HR Employee record (which holds PII).
model TeamMember {
  id             String        @id @default(uuid()) @db.Uuid
  employeeId     String?       @unique @map("employee_id") @db.Uuid
  name           String
  slug           String        @unique
  title          String
  shortBio       String        @map("short_bio")
  bio            String?
  photoUrl       String?       @map("photo_url")
  specialization String?
  experience     String?
  qualifications String?
  /// { instagram, facebook, youtube, linkedin, website }
  socialLinks    Json?         @map("social_links")
  displayOrder   Int           @default(0) @map("display_order")
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([status, displayOrder])
  @@map("team_members")
}

enum VideoSource {
  NONE
  YOUTUBE
  VIMEO
  UPLOAD
}

model Testimonial {
  id                  String        @id @default(uuid()) @db.Uuid
  studentId           String?       @map("student_id") @db.Uuid
  studentName         String        @map("student_name")
  photoUrl            String?       @map("photo_url")
  videoSource         VideoSource   @default(NONE) @map("video_source")
  /// YouTube/Vimeo page URL, or the uploaded file's public URL.
  videoUrl            String?       @map("video_url")
  posterUrl           String?       @map("poster_url")
  quote               String
  courseName          String?       @map("course_name")
  displayOrder        Int           @default(0) @map("display_order")
  status              PublishStatus @default(DRAFT)
  isFeatured          Boolean       @default(false) @map("is_featured")
  // Consent for public display — required before publishing.
  consentName         Boolean       @default(false) @map("consent_name")
  consentPhoto        Boolean       @default(false) @map("consent_photo")
  consentVideo        Boolean       @default(false) @map("consent_video")
  consentRecordedAt   DateTime?     @map("consent_recorded_at")
  consentRecordedById String?       @map("consent_recorded_by") @db.Uuid
  consentNote         String?       @map("consent_note")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@index([status, displayOrder])
  @@map("testimonials")
}

model Faq {
  id           String        @id @default(uuid()) @db.Uuid
  question     String
  answer       String
  /// Where it shows: HOME | CLASSES | TRAINING | CONTACT
  page         String        @default("HOME")
  displayOrder Int           @default(0) @map("display_order")
  status       PublishStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([page, status, displayOrder])
  @@map("faqs")
}

model Announcement {
  id           String        @id @default(uuid()) @db.Uuid
  message      String
  linkLabel    String?       @map("link_label")
  linkUrl      String?       @map("link_url")
  startsAt     DateTime?     @map("starts_at")
  endsAt       DateTime?     @map("ends_at")
  status       PublishStatus @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@map("announcements")
}

model GalleryItem {
  id           String        @id @default(uuid()) @db.Uuid
  kind         MediaKind     @default(IMAGE)
  url          String
  posterUrl    String?       @map("poster_url")
  caption      String?
  alt          String?
  album        String?
  displayOrder Int           @default(0) @map("display_order")
  status       PublishStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status, displayOrder])
  @@map("gallery_items")
}

/// A blog article on the website (/blog/<slug>). The body is Markdown.
model BlogPost {
  id             String        @id @default(uuid()) @db.Uuid
  title          String
  slug           String        @unique
  excerpt        String
  body           String
  coverImageUrl  String?       @map("cover_image_url")
  coverAlt       String?       @map("cover_alt")
  authorName     String?       @map("author_name")
  tags           String[]      @default([])
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  isFeatured     Boolean       @default(false) @map("is_featured")
  /// Shown as the article date and used for ordering (newest first). Set on first publish if empty.
  publishedAt    DateTime?     @map("published_at")
  displayOrder   Int           @default(0) @map("display_order")
  status         PublishStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("blog_posts")
}

// ───────────────────────── WhatsApp: consent, templates, rules, campaigns ─────────────────────────

enum ConsentState {
  OPTED_IN
  OPTED_OUT
}

/// Append-only consent ledger. The latest row for a mobile is its current state.
model WhatsAppConsent {
  id           String       @id @default(uuid()) @db.Uuid
  mobile       String
  state        ConsentState
  /// WEBSITE_SIGNUP | ACCOUNT_SETTINGS | STAFF_RECORDED | INBOUND_KEYWORD
  source       String
  /// Exact wording the person agreed to (or a staff note).
  consentText  String?      @map("consent_text")
  studentId    String?      @map("student_id") @db.Uuid
  accountId    String?      @map("account_id") @db.Uuid
  recordedById String?      @map("recorded_by") @db.Uuid
  ip           String?
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([mobile, createdAt])
  @@map("whatsapp_consents")
}

/// A template approved in Meta (synced, or entered by hand). Only APPROVED templates are sent.
model WhatsAppTemplate {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  language      String    @default("en")
  /// UTILITY | MARKETING | AUTHENTICATION
  category      String
  /// Meta status: APPROVED | PENDING | REJECTED | PAUSED | DISABLED
  status        String
  bodyText      String?   @map("body_text")
  /// Number of {{n}} body variables.
  variableCount Int       @default(0) @map("variable_count")
  metaId        String?   @map("meta_id")
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  rules     ReminderRule[]
  campaigns MessageCampaign[]

  @@unique([name, language])
  @@map("whatsapp_templates")
}

/// Automatic reminder rule. See messaging/rules.ts for the trigger list.
model ReminderRule {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  trigger     String
  /// Days before the event (negative = after). Ignored by event triggers.
  offsetDays  Int      @default(0) @map("offset_days")
  templateId  String   @map("template_id") @db.Uuid
  /// One entry per template variable: a placeholder such as "{name}" or fixed text.
  params      Json
  isEnabled   Boolean  @default(false) @map("is_enabled")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  template WhatsAppTemplate @relation(fields: [templateId], references: [id])

  @@index([trigger, isEnabled])
  @@map("reminder_rules")
}

/// An admin-initiated send to one or more students, now or at a scheduled time.
model MessageCampaign {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  templateId     String   @map("template_id") @db.Uuid
  params         Json
  /// Student ids chosen by the admin.
  recipientIds   Json     @map("recipient_ids")
  scheduledAt    DateTime @map("scheduled_at")
  /// SCHEDULED | QUEUED | CANCELLED
  status         String   @default("SCHEDULED")
  recipientCount Int      @default(0) @map("recipient_count")
  skippedCount   Int      @default(0) @map("skipped_count")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  template WhatsAppTemplate @relation(fields: [templateId], references: [id])

  @@index([status, scheduledAt])
  @@map("message_campaigns")
}

// ───────────────────────── Online payments (Razorpay) ─────────────────────────

enum OrderStatus {
  CREATED
  ATTEMPTED
  PAID
  FAILED
  EXPIRED
  /// Money captured but could not be applied (e.g. invoice already settled) — staff must refund.
  NEEDS_REVIEW
}

model PaymentOrder {
  id             String      @id @default(uuid()) @db.Uuid
  gateway        String      @default("RAZORPAY")
  gatewayOrderId String      @unique @map("gateway_order_id")
  accountId      String      @map("account_id") @db.Uuid
  /// INVOICE | PLAN
  purpose        String
  invoiceId      String?     @map("invoice_id") @db.Uuid
  coursePlanId   String?     @map("course_plan_id") @db.Uuid
  planStartDate  DateTime?   @map("plan_start_date") @db.Date
  /// Amount computed on the server when the order was created.
  amountPaise    BigInt      @map("amount_paise")
  currency       String      @default("INR")
  description    String
  status         OrderStatus @default(CREATED)
  /// Set once the money has been recorded as a Payment + Receipt.
  paymentId      String?     @unique @map("payment_id") @db.Uuid
  enrollmentId   String?     @map("enrollment_id") @db.Uuid
  failureReason  String?     @map("failure_reason")
  paidAt         DateTime?   @map("paid_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  account      CustomerAccount  @relation(fields: [accountId], references: [id])
  transactions GatewayPayment[]

  @@index([accountId, createdAt])
  @@index([status, updatedAt])
  @@map("payment_orders")
}

/// One row per gateway payment attempt on an order.
model GatewayPayment {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  gatewayPaymentId String   @unique @map("gateway_payment_id")
  /// created | authorized | captured | failed | refunded
  status           String
  method           String?
  amountPaise      BigInt   @map("amount_paise")
  feePaise         BigInt?  @map("fee_paise")
  taxPaise         BigInt?  @map("tax_paise")
  refundedPaise    BigInt   @default(0) @map("refunded_paise")
  errorCode        String?  @map("error_code")
  errorReason      String?  @map("error_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  order   PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@map("gateway_payments")
}

model Refund {
  id               String    @id @default(uuid()) @db.Uuid
  gatewayPaymentId String    @map("gateway_payment_id") @db.Uuid
  gatewayRefundId  String?   @unique @map("gateway_refund_id")
  amountPaise      BigInt    @map("amount_paise")
  /// PENDING | PROCESSED | FAILED
  status           String
  reason           String?
  initiatedById    String?   @map("initiated_by") @db.Uuid
  /// When the refund was reflected on the invoice/payment (exactly once).
  appliedAt        DateTime? @map("applied_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  gatewayPayment GatewayPayment @relation(fields: [gatewayPaymentId], references: [id])

  @@index([gatewayPaymentId])
  @@map("refunds")
}

/// Key/value markers for the job runner (e.g. "daily reminders ran for 2026-10-17").
model JobMarker {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("job_markers")
}
